@page "/"
@inject IJSRuntime JS
@using FF14Card.Class
@using FF14Card.Services
@inject CanvasStateService CanvasState
@implements IDisposable
@using System.Text.Json

<PageTitle>抽拉換圖卡製作</PageTitle>

<script src="js/canvas.js"></script>

<div class="image-canvas-container">
    <!-- 左側畫布 -->
    <div class="canvas-section">
        <p class="status-message">@statusMessage</p>
        <canvas id="myCanvas" width="3508" height="2480"></canvas>
    </div>

    <!-- 右側控制面板 -->
    <div class="control-panel">
        <!-- 標題框 -->
        <div class="panel-box title-box">
            <h1>抽拉換圖卡</h1>
        </div>

        <!-- 刀模和下拉選項兩個框 -->
        <div class="top-controls-row">
            <!-- 刀模框 -->
            <div class="panel-box mold-box">
                <div class="builtin-layers">
                    @foreach (var builtIn in builtInLayers)
                    {
                        @if(builtIn.Name != "定位")               
                        {
                            <div class="builtin-layer-item">
                                <input type="checkbox" checked="@builtIn.Visible"
                                       @onchange="() => CheckboxToggleBuiltInVisibility(builtIn)" />
                                <span>@builtIn.Name</span>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- 下拉選項框 -->
            <div class="panel-box selector-box">
                <select @onchange="WindowChanged" class="window-select">
                    <option value="0">A</option>
                    <option value="1">B</option>
                    <option value="2">C</option>
                    <option value="3">D</option>
                </select>
            </div>
        </div>

        <!-- 圖層列表區 + 右側按鈕 -->
        <div class="layers-row">
            <!-- 圖層列表大框 -->
            <div class="panel-box layers-box">
                <!-- 上傳圖片 -->
                <div class="upload-section">
                    <InputFile OnChange="HandleFileSelected" accept="image/*" />
                </div>

                <!-- 圖層列表 -->
                <h4>圖層列表 (@userLayers.Count 張)</h4>
                <ul id="layerList">
                    @foreach (var layer in userLayers)
                    {
                        <li class="layer-item @(selectedLayer == layer ? "selected" : "")" data-id="@layer.Id"
                            @onclick="() => SelectLayer(layer)">
                            <span class="layer-visibility-icon"
                                  @onclick="() => { ToggleVisibility(layer); }"
                                  @onclick:stopPropagation>
                                @(layer.Visible ? "👁️" : "🙈")
                            </span>
                            <span class="layer-name">📄 @layer.Name</span>
                            @if (selectedLayer == layer)
                            {
                                <span class="selected-indicator">●</span>
                            }
                        </li>
                    }
                </ul>

                <!-- 裁切按鈕 -->
                <div class="crop-section">
                    @if (!cropMode)
                    {
                        <button @onclick="ToggleCropMode" class="crop-button">✂️ 裁切模式</button>
                    }
                    else
                    {
                        <button @onclick="ApplyCrop" disabled="@(!IsCropAvailable)" class="apply-crop-button">套用裁切</button>
                        <button @onclick="CancelCrop" class="cancel-crop-button">取消裁切</button>
                    }
                </div>
            </div>

            <!-- 右側按鈕組 -->
            <div class="side-buttons">
                <button @onclick="BringToFront" title="上一層">↑</button>
                <button @onclick="SendToBack" title="下一層">↓</button>
                <button @onclick="DeleteSelected" class="delete-button" title="刪除">🗑️</button>
            </div>
        </div>

        <!-- 下方操作按鈕框 -->
        <div class="panel-box action-box">
            <button @onclick="ClearCanvas" class="action-button clear-button">🗑️ 清除全部</button>
            <button @onclick="DownloadCanvasAsync" class="action-button download-button">💾 下載圖片</button>
        </div>
    </div>
</div>

@code {
    private string statusMessage = "✅ 準備就緒！請上傳圖片";
    private List<Layer> builtInLayers = new();   // 內建圖片
    private List<Layer> userLayers = new();      // 用戶上傳的圖片
    private Layer? selectedLayer;
    private double selectedWidth ;
    private double selectedHeight ;
    private List<string> modImageUrls = new();
    private List<string> positionImageUrls = new();
    private bool cropMode = false;
    private bool IsCropAvailable => cropMode && selectedLayer != null;
    private DotNetObjectReference<ImageCanvas>? dotNetRef;// 改成你的 class 名稱
    private IJSObjectReference? module;

    [JSInvokable]
    public void ReceiveLayerOrder(string[] newOrder)
    {
        if (newOrder == null || newOrder.Length == 0) return;

        // Reorder userLayers to match newOrder (preserve any missing items at end)
        var map = userLayers.ToDictionary(l => l.Id);
        var newList = new List<Layer>();
        foreach (var id in newOrder)
        {
            if (map.TryGetValue(id, out var layer))
            {
                newList.Add(layer);
                map.Remove(id);
            }
        }
        // append any remaining user layers (shouldn't normally happen)
        foreach (var kv in map)
        {
            newList.Add(kv.Value);
        }

        userLayers = newList;

        // ensure selectedLayer reference remains valid
        if (selectedLayer != null)
        {
            selectedLayer = userLayers.FirstOrDefault(l => l.Id == selectedLayer.Id) ?? selectedLayer;
        }

        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void JsSelectLayer(string id)
    {
        if (string.IsNullOrEmpty(id)) return;
        var layer = userLayers.FirstOrDefault(l => l.Id == id);
        if (layer != null)
        {
            selectedLayer = layer;
            InvokeAsync(StateHasChanged);
        }
    }



    private async Task ToggleCropMode()
    {
        cropMode = !cropMode;
        if (cropMode)
        {
            await JS.InvokeVoidAsync("enableCropMode", "myCanvas");
            statusMessage = "✂️ 裁切模式啟用：請拖曳在畫布上畫出裁切框，完成後按「套用裁切」";
        }
        else
        {
            await JS.InvokeVoidAsync("disableCropMode", "myCanvas");
            statusMessage = "✅ 已離開裁切模式";
        }
        StateHasChanged();
    }

    private async Task ApplyCrop()
    {
        if (selectedLayer == null) return;
        await JS.InvokeVoidAsync("applyCropToSelected", "myCanvas", selectedLayer.Id);
        // JS 端已替換圖像之後，可視需要重新整理狀態
        cropMode = false;
        await JS.InvokeVoidAsync("disableCropMode", "myCanvas");
        statusMessage = "✂️ 已套用裁切";
        StateHasChanged();
    }

    private async Task CancelCrop()
    {
        cropMode = false;
        await JS.InvokeVoidAsync("disableCropMode", "myCanvas");
        statusMessage = "已取消裁切";
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        // 不在此載入內建圖片，改為在 OnAfterRenderAsync firstRender 時載入
        CanvasState.OnStateChanged += StateHasChanged;
        await Task.CompletedTask;
    }

    private async Task AddBuiltInImage(string name, string url)
    {
        // Avoid adding duplicates
        if (builtInLayers.Any(b => b.Name == name || b.DataUrl == url))
            return;

        var layer = new Layer
        {
            Name = name,
            DataUrl = url,
            Visible = true
        };

        builtInLayers.Add(layer);

        // 確保 canvas.js 已加載並初始化
        try
        {
            // 調用 JS 以確保 canvas 已初始化
            await JS.InvokeVoidAsync("eval", "if (typeof init === 'function') init();");
        }
        catch { }

        // 傳入畫布尺寸，讓 JS 調整為填滿。傳遞第四個參數 true 表示此為內建圖層
        await JS.InvokeVoidAsync("addFullSizeImage", "myCanvas", url, layer.Id, true);
    }

    /// <summary>
    /// 初始化所有窗戶的圖片 URL 列表
    /// </summary>
    private void InitializeWindowUrls()
    {
        if (modImageUrls.Count > 0) return; // 已初始化過

        modImageUrls.Add("images/window/抽拉換圖卡-A刀模.svg");
        positionImageUrls.Add("images/window/抽拉換圖卡-A定位.svg");
        modImageUrls.Add("images/window/抽拉換圖卡-B刀模.svg");
        positionImageUrls.Add("images/window/抽拉換圖卡-B定位.svg");
        modImageUrls.Add("images/window/抽拉換圖卡-C刀模.svg");
        positionImageUrls.Add("images/window/抽拉換圖卡-C定位.svg");
        modImageUrls.Add("images/window/抽拉換圖卡-D刀模.svg");
        positionImageUrls.Add("images/window/抽拉換圖卡-D定位.svg");
    }

    /// <summary>
    /// 從 CanvasState.Layers 中恢復 builtInLayers
    /// </summary>
    private async Task RestoreBuiltInLayers()
    {
        if (builtInLayers.Count > 0) 
        {

            return; // 已經恢復過
        }


        int restoredCount = 0;

        foreach (var layerItem in CanvasState.Layers.Where(l => l.IsBuiltIn))
        {
            // 使用 JsLayerId（這是首次加載時用 Layer.Id 保存的）
            // 這確保了 JavaScript 側的 id 和 C# 側的 Layer.Id 一致
            var jsId = layerItem.JsLayerId;
            if (string.IsNullOrEmpty(jsId))
            {
                // 備用：如果 JsLayerId 為空，嘗試用 Guid 轉換（但這可能不會匹配原始的 Layer.Id）
                jsId = layerItem.Id.ToString();

            }

            var layer = new Layer
            {
                Id = jsId,  // 使用保存的 JavaScript ID
                Name = layerItem.Name,
                DataUrl = layerItem.ImageUrl,
                Visible = layerItem.IsVisible
            };
            builtInLayers.Add(layer);
            restoredCount++;


        }


        await Task.CompletedTask;
    }

    private async Task WindowChanged(ChangeEventArgs e)
    {
        var selectedValue = int.TryParse(e.Value?.ToString(), out int result);
     
        var modid = builtInLayers.FirstOrDefault(l => l.Name == "刀模")?.Id;
        var positionid = builtInLayers.FirstOrDefault(l => l.Name == "定位")?.Id;
        if (selectedValue)
        {
            await JS.InvokeVoidAsync("replaceImage", "myCanvas", modImageUrls[result], modid);
            await JS.InvokeVoidAsync("replaceImage", "myCanvas", positionImageUrls[result], positionid);
        }
        else
        {
            statusMessage = "❌ 選擇的窗戶無效 請截圖告知開發人員";
        }
    }


    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            using var stream = file.OpenReadStream(15 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            var base64 = Convert.ToBase64String(ms.ToArray());
            var dataUrl = $"data:{file.ContentType};base64,{base64}";

            var layer = new Layer
            {
                Name = file.Name,
                DataUrl = dataUrl,
                Visible = true
            };

            userLayers.Insert(0, layer);  // 插入到最前面（下方）
            selectedLayer = layer;

            await JS.InvokeVoidAsync("addImageBelow", "myCanvas", dataUrl, layer.Id);
            await JS.InvokeVoidAsync("setSelectedLayer", layer.Id);

            statusMessage = $"✅ 已加入 {file.Name}";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            statusMessage = $"❌ 上傳失敗：{ex.Message}";
        }
    }

    private void SelectLayer(Layer layer)
    {
        selectedLayer = layer;
        JS.InvokeVoidAsync("setSelectedLayer", layer.Id);
    }

    private async Task BringToFront()
    {
        // Move selected layer one step up (towards top of list)
        if (selectedLayer == null) return;
        var idx = userLayers.IndexOf(selectedLayer);
        if (idx > 0)
        {
            userLayers.RemoveAt(idx);
            userLayers.Insert(idx - 1, selectedLayer);
            // notify JS of new order
            var newOrder = userLayers.Select(l => l.Id).ToArray();
            await JS.InvokeVoidAsync("updateLayerOrder", (object)newOrder);
            // 只使用 updateLayerOrder 同步 zIndex，避免與 moveLayerUp 產生 race condition
            await JS.InvokeVoidAsync("setSelectedLayer", selectedLayer.Id);
            StateHasChanged();
        }
    }

    private async Task SendToBack()
    {
        // Move selected layer one step down (towards bottom of list)
        if (selectedLayer == null) return;
        var idx = userLayers.IndexOf(selectedLayer);
        if (idx >= 0 && idx < userLayers.Count - 1)
        {
            userLayers.RemoveAt(idx);
            userLayers.Insert(idx + 1, selectedLayer);
            var newOrder = userLayers.Select(l => l.Id).ToArray();
            await JS.InvokeVoidAsync("updateLayerOrder", (object)newOrder);
            // 只使用 updateLayerOrder 同步 zIndex，避免與 moveLayerDown 產生 race condition
            await JS.InvokeVoidAsync("setSelectedLayer", selectedLayer.Id);
            StateHasChanged();
        }
    }



    private async Task DeleteSelected()
    {
        if (selectedLayer == null) return;

        if (!await JS.InvokeAsync<bool>("confirm", $"確定刪除「{selectedLayer.Name}」？"))
            return;

        await JS.InvokeVoidAsync("deleteLayer", "myCanvas", selectedLayer.Id);

        userLayers.Remove(selectedLayer);
        selectedLayer = userLayers.LastOrDefault();

        if (selectedLayer != null)
            await JS.InvokeVoidAsync("setSelectedLayer", selectedLayer.Id);

        StateHasChanged();
        statusMessage = "🗑️ 已刪除";
    }

    private async Task ClearCanvas()
    {
        // 只清除用戶上傳的圖片,保留內建圖片
        userLayers.Clear();
        selectedLayer = null;

        // JS 的 clearCanvas 會自動保留 builtIn 圖片並重繪
        await JS.InvokeVoidAsync("clearCanvas", "myCanvas");

        statusMessage = "已清除上傳的圖片";
        StateHasChanged();
    }

    private async Task DownloadCanvasAsync()
    {
        await JS.InvokeVoidAsync("downloadImage", "myCanvas");
        statusMessage = "💾 已下載圖片 (PNG)";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // register DotNet ref and ensure JS functions are available before calling
            dotNetRef = DotNetObjectReference.Create(this);
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/canvasStateInterop.js");

            // wait until registerDotNetRef exists (script tag may not have loaded yet)
            var maxMs = 3000;
            var waited = 0;
            var available = false;
            while (waited < maxMs)
            {
                try
                {
                    available = await JS.InvokeAsync<bool>("eval", "typeof window.registerDotNetRef === 'function'");
                }
                catch
                {
                    available = false;
                }
                if (available) break;
                await Task.Delay(100);
                waited += 100;
            }

            if (available)
            {
                await JS.InvokeVoidAsync("registerDotNetRef", dotNetRef);
                // 禁用列表拖拉 (使用按鈕控制圖層)
                try { await JS.InvokeVoidAsync("eval", "document.getElementById('layerList').dataset.sortable='false'"); } catch { }
            }

            // ensure sortable is initialized after render
            try { await JS.InvokeVoidAsync("makeLayerListSortable", "layerList"); } catch { }
            // 先載入 ES Module
            if (module == null)
            {
                module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/canvasStateInterop.js");
            }

            // now add built-in images via JS (do this after JS is ready)
            // 判斷首次加載還是頁面返回的邏輯：
            // 1. builtInLayers.Count == 0 && CanvasState.Layers.Count == 0 → 首次加載
            // 2. builtInLayers.Count == 0 && CanvasState.Layers.Count > 0 → 頁面返回

            if (builtInLayers.Count == 0 && CanvasState.Layers.Count == 0)
            {
                // 首次進入頁面 → 初始化內建圖片

                await AddBuiltInImageToState("刀模", "images/window/抽拉換圖卡-A刀模.svg", isBuiltIn: true);
                await AddBuiltInImageToState("定位", "images/window/抽拉換圖卡-A定位.svg", isBuiltIn: true);

                statusMessage = "✅ 已載入兩張內建圖片（固定最上層）";

                // 初始化窗戶 URL 列表
                InitializeWindowUrls();
                StateHasChanged();
            }
            else if (builtInLayers.Count == 0 && CanvasState.Layers.Count > 0)
            {
                // 頁面返回 → builtInLayers被清空, CanvasState有數據



                // 在頁面返回時也確保 URL 列表被初始化
                if (modImageUrls.Count == 0)
                {
                    InitializeWindowUrls();
                }

                // 重新填充 builtInLayers（從 CanvasState.Layers 中恢復）
                await RestoreBuiltInLayers();


                // 清空並還原 Canvas 狀態
                await JS.InvokeVoidAsync("eval", "window.__ff14card_images && (window.__ff14card_images.length = 0);");
                await JS.InvokeVoidAsync("clearCanvas", "myCanvas");

                // 小延遲，確保 canvas 清空完成
                await Task.Delay(100);

                // 調用還原函數
                var json = CanvasState.ExportToJson();

                await module.InvokeVoidAsync("restoreCanvasState", json);

                StateHasChanged();
            }

            StateHasChanged();
        }
        else
        {
            // ensure sortable re-initialized after subsequent renders
            try { await JS.InvokeVoidAsync("makeLayerListSortable", "layerList"); } catch { }
        }
    }

    /// <summary>
    /// 同時寫入 CanvasStateService + 呼叫原本的 JS 繪圖
    /// </summary>
    private async Task AddBuiltInImageToState(string name, string url, bool isBuiltIn = true)
    {
        // 先創建 Layer 對象（以獲取其 ID）
        var layerObj = new Layer
        {
            Name = name,
            DataUrl = url,
            Visible = true
        };

        // 添加到本地列表
        builtInLayers.Add(layerObj);

        // 確保 canvas.js 已加載並初始化
        try
        {
            await JS.InvokeVoidAsync("eval", "if (typeof init === 'function') init();");
        }
        catch { }

        // 呼叫 JS 函式進行實際繪圖
        await JS.InvokeVoidAsync("addFullSizeImage", "myCanvas", url, layerObj.Id, true);

        // 1. 寫入 Service（讓切換頁面後能還原）
        // 注意：這裡保存 Layer 的 ID 到 JsLayerId 確保 C# 和 JS 端的 ID 一致
        var layerItem = new LayerItem
        {
            Id = Guid.NewGuid(),
            Name = name,
            ImageUrl = url,
            IsBuiltIn = isBuiltIn,
            X = 150,
            Y = 120,
            Scale = 0.9,
            Opacity = 1.0,
            IsVisible = true,
            ZIndex = CanvasState.Layers.Count,
            JsLayerId = layerObj.Id  // 保存 JavaScript 側的圖層 ID
        };
        CanvasState.AddLayer(layerItem);
    }

    private async Task RestoreCanvasFromStateAsync()
    {
        if (module == null)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/canvas-interop.js");
        }
        // 把目前 Service 的狀態傳給 JS 還原
        var json = CanvasState.ExportToJson();
        await JS.InvokeVoidAsync("restoreCanvasState", json);
    }

    private async Task RedrawCanvasFromStateAsync()
    {
        if (module == null) return;
        var json = CanvasState.ExportToJson();
        await JS.InvokeVoidAsync("redrawCanvasFromState", json);
    }

    // 讓 JS 可以呼叫回來更新狀態（重要！）
    [JSInvokable]
    public async Task UpdateLayerFromJs(string jsonLayer)
    {
        var layer = JsonSerializer.Deserialize<LayerItem>(jsonLayer);
        if (layer != null)
        {
            CanvasState.UpdateLayer(layer);
        }
    }

    public void Dispose()
    {
        CanvasState.OnStateChanged -= StateHasChanged;
        dotNetRef?.Dispose();
    }

    private void ToggleVisibilityHandler(Layer layer)
    {
        ToggleVisibility(layer);
    }

    private async Task ToggleVisibility(Layer layer)
    {
        layer.Visible = !layer.Visible;

        await JS.InvokeVoidAsync("toggleLayerVisibility", "myCanvas", layer.Id, layer.Visible);

        // 避免點擊眼睛時觸發選取
        StateHasChanged();
    }

    private async Task CheckboxToggleBuiltInVisibility(Layer layer)
    {
        layer.Visible = !layer.Visible;
        await JS.InvokeVoidAsync("toggleLayerVisibility", "myCanvas", layer.Id, layer.Visible);
        StateHasChanged();
    }

    private void CheckboxToggleVisibility(Layer layer)
    {
        layer.Visible = !layer.Visible;
        JS.InvokeVoidAsync("toggleLayerVisibility", "myCanvas", layer.Id, layer.Visible);
        StateHasChanged();
    }
}
